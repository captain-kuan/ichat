{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES6",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["DOM", "ES2017"],
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@c/*": ["components/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["./**/*"]
}
